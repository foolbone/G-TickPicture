/android/app/release

# 正式签名密钥（绝不入库：丢了 keystore 无法更新应用，泄露可被冒名签名）
android/key.properties
*.jks
*.keystore

# ── PP-OCRv6 模型（P4 诉求 4）─────────────────────────────────
# 几十 MB 的二进制，不进版本控制 —— 用 tools/fetch_ppocr_model.ps1 拉取。
# 缺失时**编译照常通过**，运行期自动回退 ML Kit（见 ocr_engine_factory.dart）。
android/app/src/main/assets/ppocr/*.onnx
android/app/src/main/assets/ppocr/keys.txt
